{
    "name": "ugarit/tinker",
    "description": "Powerful REPL for the Ugarit framework.",
    "keywords": [
        "tinker",
        "repl",
        "psysh",
        "ugarit"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "heritage/console": "^1.00.00",
        "heritage/contracts": "^1.00.00",
        "heritage/support": "^1.00.00",
        "psy/psysh": "^0.12.19",
        "symfony/var-dumper": "^5.4|^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "mockery/mockery": "~1.3.3|^1.4.2",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.5|^11.5"
    },
    "suggest": {
        "heritage/database": "The Heritage Database package (^8.0|^9.0|^10.0|^11.0|^12.0|^13.0)."
    },
    "autoload": {
        "psr-4": {
            "Ugarit\\Tinker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ugarit\\Tinker\\Tests\\": "tests/",
            "App\\": "tests/fixtures/app",
            "One\\Two\\": "tests/fixtures/vendor/one/two"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.x-dev"
        },
        "ugarit": {
            "providers": [
                "Ugarit\\Tinker\\TinkerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.00.00"
}
